+static void cst3xx_keep_contact(struct hynitron_ts_data *ts_data, u8 id)
+{
+	struct input_mt *mt = ts_data->input_dev->mt;
+
+	if (id >= mt->num_slots || id >= ARRAY_SIZE(ts_data->unpressed) ||
+	    !input_mt_is_active(&mt->slots[id]) ||
+	    ts_data->unpressed[id] >= CST3XX_MAX_UNPRESSED_FRAMES)
+		return;
+
+	if (!ts_data->unpressed[id]++)
+		ts_data->kept_at[id] = jiffies;
+	input_mt_slot(ts_data->input_dev, id);
+	input_mt_report_slot_state(ts_data->input_dev, MT_TOOL_FINGER, true);
+}
+
+static void cst3xx_release_slots(struct hynitron_ts_data *ts_data, bool all,
+				 unsigned int pressed)
+{
+	struct input_mt *mt = ts_data->input_dev->mt;
+	bool dropped = false;
+	unsigned int id;
+
+	for (id = 0; id < mt->num_slots && id < ARRAY_SIZE(ts_data->unpressed); id++) {
+		if ((!all && !ts_data->unpressed[id]) || (pressed & BIT(id)))
+			continue;
+		ts_data->unpressed[id] = 0;
+		if (!input_mt_is_active(&mt->slots[id]))
+			continue;
+		input_mt_slot(ts_data->input_dev, id);
+		input_mt_report_slot_state(ts_data->input_dev, MT_TOOL_FINGER, false);
+		dropped = true;
+	}
+
+	if (dropped) {
+		input_mt_report_pointer_emulation(ts_data->input_dev, false);
+		input_sync(ts_data->input_dev);
+	}
+}
+
+static void cst3xx_drop_kept(struct hynitron_ts_data *ts_data)
+{
+	cst3xx_release_slots(ts_data, false, 0);
+}
+
+static void cst3xx_arm_release(struct hynitron_ts_data *ts_data,
+			       unsigned long now)
+{
+	unsigned long deadline, next = 0;
+	bool pending = false;
+	unsigned int id;
+
+	for (id = 0; id < ARRAY_SIZE(ts_data->unpressed); id++) {
+		if (!ts_data->unpressed[id])
+			continue;
+		deadline = ts_data->kept_at[id] +
+			   msecs_to_jiffies(CST3XX_KEEP_TIMEOUT_MS);
+		if (!pending || time_before(deadline, next))
+			next = deadline;
+		pending = true;
+	}
+
+	if (pending)
+		mod_delayed_work(system_highpri_wq, &ts_data->release_work,
+				 time_after(next, now) ? next - now : 0);
+}
+
+static void cst3xx_release_work(struct work_struct *work)
+{
+	struct hynitron_ts_data *ts_data =
+		container_of(to_delayed_work(work), struct hynitron_ts_data,
+			     release_work);
+	struct input_mt *mt = ts_data->input_dev->mt;
+	bool dropped = false;
+	unsigned long now;
+	unsigned int id;
+
+	mutex_lock(&ts_data->report_lock);
+	now = jiffies;
+	for (id = 0; id < mt->num_slots && id < ARRAY_SIZE(ts_data->unpressed); id++) {
+		if (!ts_data->unpressed[id] ||
+		    time_before(now, ts_data->kept_at[id] +
+				msecs_to_jiffies(CST3XX_KEEP_TIMEOUT_MS)))
+			continue;
+		ts_data->unpressed[id] = 0;
+		if (!input_mt_is_active(&mt->slots[id]))
+			continue;
+		input_mt_slot(ts_data->input_dev, id);
+		input_mt_report_slot_state(ts_data->input_dev, MT_TOOL_FINGER, false);
+		dropped = true;
+	}
+
+	if (dropped) {
+		input_mt_report_pointer_emulation(ts_data->input_dev, false);
+		input_sync(ts_data->input_dev);
+	}
+
+	cst3xx_arm_release(ts_data, now);
+	mutex_unlock(&ts_data->report_lock);
+}
