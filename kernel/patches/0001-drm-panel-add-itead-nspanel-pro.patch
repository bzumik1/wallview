+// SPDX-License-Identifier: GPL-2.0
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+#include <video/mipi_display.h>
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+struct nspanel_pro_command {
+	u8 delay_ms;
+	u8 length;
+	u8 data[17];
+};
+
+#define NSPANEL_PRO_COMMAND(delay, ...) \
+	{ delay, sizeof((u8[]){ __VA_ARGS__ }), { __VA_ARGS__ } }
+
+static const struct nspanel_pro_command nspanel_pro_init_sequence[] = {
+	NSPANEL_PRO_COMMAND(0, 0xff, 0x77, 0x01, 0x00, 0x00, 0x10),
+	NSPANEL_PRO_COMMAND(0, 0xc0, 0x3b, 0x00),
+	NSPANEL_PRO_COMMAND(0, 0xc1, 0x0d, 0x02),
+	NSPANEL_PRO_COMMAND(0, 0xc2, 0x21, 0x08),
+	NSPANEL_PRO_COMMAND(0, 0xb0, 0x00, 0x11, 0x18, 0x0e, 0x11, 0x06, 0x07, 0x08,
+			    0x07, 0x22, 0x04, 0x12, 0x0f, 0xaa, 0x31, 0x18),
+	NSPANEL_PRO_COMMAND(0, 0xb1, 0x00, 0x11, 0x19, 0x0e, 0x12, 0x07, 0x08, 0x08,
+			    0x08, 0x22, 0x04, 0x11, 0x11, 0xa9, 0x32, 0x18),
+	NSPANEL_PRO_COMMAND(0, 0xff, 0x77, 0x01, 0x00, 0x00, 0x11),
+	NSPANEL_PRO_COMMAND(0, 0xb0, 0x60),
+	NSPANEL_PRO_COMMAND(0, 0xb1, 0x30),
+	NSPANEL_PRO_COMMAND(0, 0xb2, 0x87),
+	NSPANEL_PRO_COMMAND(0, 0xb3, 0x80),
+	NSPANEL_PRO_COMMAND(0, 0xb5, 0x49),
+	NSPANEL_PRO_COMMAND(0, 0xb7, 0x85),
+	NSPANEL_PRO_COMMAND(0, 0xb8, 0x21),
+	NSPANEL_PRO_COMMAND(0, 0xc1, 0x78),
+	NSPANEL_PRO_COMMAND(20, 0xc2, 0x78),
+	NSPANEL_PRO_COMMAND(0, 0xe0, 0x00, 0x1b, 0x02),
+	NSPANEL_PRO_COMMAND(0, 0xe1, 0x08, 0xa0, 0x00, 0x00, 0x07, 0xa0, 0x00, 0x00,
+			    0x00, 0x44, 0x44),
+	NSPANEL_PRO_COMMAND(0, 0xe2, 0x11, 0x11, 0x44, 0x44, 0xed, 0xa0, 0x00, 0x00,
+			    0xec, 0xa0, 0x00, 0x00),
+	NSPANEL_PRO_COMMAND(0, 0xe3, 0x00, 0x00, 0x11, 0x11),
+	NSPANEL_PRO_COMMAND(0, 0xe4, 0x44, 0x44),
+	NSPANEL_PRO_COMMAND(0, 0xe5, 0x0a, 0xe9, 0xd8, 0xa0, 0x0c, 0xeb, 0xd8, 0xa0,
+			    0x0e, 0xed, 0xd8, 0xa0, 0x10, 0xef, 0xd8, 0xa0),
+	NSPANEL_PRO_COMMAND(0, 0xe6, 0x00, 0x00, 0x11, 0x11),
+	NSPANEL_PRO_COMMAND(0, 0xe7, 0x44, 0x44),
+	NSPANEL_PRO_COMMAND(0, 0xe8, 0x09, 0xe8, 0xd8, 0xa0, 0x0b, 0xea, 0xd8, 0xa0,
+			    0x0d, 0xec, 0xd8, 0xa0, 0x0f, 0xee, 0xd8, 0xa0),
+	NSPANEL_PRO_COMMAND(0, 0xeb, 0x02, 0x00, 0xe4, 0xe4, 0x88, 0x00, 0x40),
+	NSPANEL_PRO_COMMAND(0, 0xec, 0x3c, 0x00),
+	NSPANEL_PRO_COMMAND(0, 0xed, 0xab, 0x89, 0x76, 0x54, 0x02, 0xff, 0xff, 0xff,
+			    0xff, 0xff, 0xff, 0x20, 0x45, 0x67, 0x98, 0xba),
+	NSPANEL_PRO_COMMAND(0, 0xff, 0x77, 0x01, 0x00, 0x00, 0x00),
+	NSPANEL_PRO_COMMAND(120, MIPI_DCS_EXIT_SLEEP_MODE),
+	NSPANEL_PRO_COMMAND(120, MIPI_DCS_SET_DISPLAY_ON),
+};
+
+static const struct drm_display_mode nspanel_pro_mode = {
+	.clock = 16000,
+	.hdisplay = 480,
+	.hsync_start = 480 + 12,
+	.hsync_end = 480 + 12 + 10,
+	.htotal = 480 + 12 + 10 + 15,
+	.vdisplay = 480,
+	.vsync_start = 480 + 12,
+	.vsync_end = 480 + 12 + 8,
+	.vtotal = 480 + 12 + 8 + 15,
+	.width_mm = 72,
+	.height_mm = 70,
+	.flags = DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+struct nspanel_pro {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator *power;
+	struct gpio_desc *reset;
+};
+
+static inline struct nspanel_pro *to_nspanel_pro(struct drm_panel *panel)
+{
+	return container_of(panel, struct nspanel_pro, panel);
+}
+
+static int nspanel_pro_prepare(struct drm_panel *panel)
+{
+	struct nspanel_pro *ctx = to_nspanel_pro(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	const struct nspanel_pro_command *command;
+	int ret;
+
+	ret = regulator_enable(ctx->power);
+	if (ret)
+		return ret;
+
+	msleep(20);
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	msleep(20);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	msleep(20);
+
+	for (command = nspanel_pro_init_sequence;
+	     command < nspanel_pro_init_sequence + ARRAY_SIZE(nspanel_pro_init_sequence);
+	     command++) {
+		mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, command->data, command->length);
+		if (command->delay_ms)
+			mipi_dsi_msleep(&dsi_ctx, command->delay_ms);
+	}
+
+	if (dsi_ctx.accum_err) {
+		gpiod_set_value_cansleep(ctx->reset, 1);
+		regulator_disable(ctx->power);
+		return dsi_ctx.accum_err;
+	}
+
+	return 0;
+}
+
+static int nspanel_pro_enable(struct drm_panel *panel)
+{
+	msleep(40);
+
+	return 0;
+}
+
+static int nspanel_pro_unprepare(struct drm_panel *panel)
+{
+	struct nspanel_pro *ctx = to_nspanel_pro(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	regulator_disable(ctx->power);
+
+	return 0;
+}
+
+static int nspanel_pro_get_modes(struct drm_panel *panel,
+				 struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &nspanel_pro_mode);
+}
+
+static const struct drm_panel_funcs nspanel_pro_funcs = {
+	.prepare = nspanel_pro_prepare,
+	.enable = nspanel_pro_enable,
+	.unprepare = nspanel_pro_unprepare,
+	.get_modes = nspanel_pro_get_modes,
+};
+
+static int nspanel_pro_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct nspanel_pro *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct nspanel_pro, panel,
+				   &nspanel_pro_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->dsi = dsi;
+
+	ctx->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset), "failed to get reset gpio\n");
+
+	ctx->power = devm_regulator_get(dev, "power");
+	if (IS_ERR(ctx->power))
+		return dev_err_probe(dev, PTR_ERR(ctx->power), "failed to get power supply\n");
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return ret;
+
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 2;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void nspanel_pro_remove(struct mipi_dsi_device *dsi)
+{
+	struct nspanel_pro *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id nspanel_pro_of_match[] = {
+	{ .compatible = "itead,nspanel-pro-panel" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, nspanel_pro_of_match);
+
+static struct mipi_dsi_driver nspanel_pro_driver = {
+	.driver = {
+		.name = "panel-itead-nspanel-pro",
+		.of_match_table = nspanel_pro_of_match,
+	},
+	.probe = nspanel_pro_probe,
+	.remove = nspanel_pro_remove,
+};
+module_mipi_dsi_driver(nspanel_pro_driver);
+
+MODULE_DESCRIPTION("DRM driver for the ITEAD Sonoff NSPanel Pro 480x480 DSI panel");
+MODULE_LICENSE("GPL");
