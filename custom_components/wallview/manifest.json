{
  "domain": "wallview",
  "name": "WallView",
  "after_dependencies": ["esphome", "onboarding"],
  "codeowners": ["@bzumik1"],
  "config_flow": true,
  "dependencies": ["http"],
  "documentation": "https://github.com/bzumik1/wallview/blob/main/docs/home-assistant.md",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/bzumik1/wallview/issues",
  "version": "0.1.0",
  "zeroconf": [
    {
      "type": "_esphomelib._tcp.local.",
      "properties": {
        "project_name": "wallview.*"
      }
    }
  ]
}
