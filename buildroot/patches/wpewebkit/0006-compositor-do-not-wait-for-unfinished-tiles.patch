+bool GLFenceEGL::isSignaled()
+{
+    auto display = m_display.get();
+    if (!display)
+        return true;
+
+    if (display->checkVersion(1, 5))
+        return eglClientWaitSync(display->eglDisplay(), m_sync, 0, 0) != EGL_TIMEOUT_EXPIRED;
+    return eglClientWaitSyncKHR(display->eglDisplay(), m_sync, 0, 0) != EGL_TIMEOUT_EXPIRED_KHR;
+}
