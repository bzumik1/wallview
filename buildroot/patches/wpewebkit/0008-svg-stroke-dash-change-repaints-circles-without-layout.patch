@@ -27,11 +27,14 @@
 #include "config.h"
 #include "LegacyRenderSVGEllipse.h"
 
+#include "LegacyRenderSVGRoot.h"
 #include "LegacyRenderSVGShapeInlines.h"
 #include "SVGCircleElement.h"
 #include "SVGElementTypeHelpers.h"
 #include "SVGEllipseElement.h"
 #include "SVGRenderStyle.h"
+#include "SVGResources.h"
+#include "SVGResourcesCache.h"
 #include <wtf/TZoneMallocInlines.h>
 
 namespace WebCore {
@@ -80,6 +83,22 @@ void LegacyRenderSVGEllipse::updateShapeFromElement()
         m_strokeBoundingBox->inflate(strokeWidth() / 2);
 }
 
+bool LegacyRenderSVGEllipse::strokeDashChangeRequiresLayout() const
+{
+    if (m_shapeType != ShapeType::Circle && m_shapeType != ShapeType::Ellipse)
+        return true;
+    if (hasNonScalingStroke())
+        return true;
+    for (CheckedPtr ancestor = parent(); ancestor; ancestor = ancestor->parent()) {
+        auto* resources = SVGResourcesCache::cachedResourcesForRenderer(*ancestor);
+        if (resources && resources->filter())
+            return true;
+        if (is<LegacyRenderSVGRoot>(*ancestor))
+            break;
+    }
+    return false;
+}
+
 void LegacyRenderSVGEllipse::calculateRadiiAndCenter()
 {
     Ref graphicsElement = this->graphicsElement();
