@@ -37,6 +37,8 @@ public:
     LegacyRenderSVGEllipse(SVGGraphicsElement&, RenderStyle&&);
     virtual ~LegacyRenderSVGEllipse();
 
+    bool strokeDashChangeRequiresLayout() const;
+
 private:
     ASCIILiteral renderName() const override { return "RenderSVGEllipse"_s; }
 
