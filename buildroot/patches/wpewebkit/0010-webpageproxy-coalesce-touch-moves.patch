+        static bool coalescesTouchMoves = !getenv("WALLVIEW_WEBKIT_NO_TOUCH_COALESCING");
+        auto& coalescedTouchMoveEvent = internals().coalescedTouchMoveEvent;
+        if (coalescesTouchMoves && !internals().touchEventQueue.isEmpty() && event.type() == WebEventType::TouchMove
+            && (!coalescedTouchMoveEvent || canCoalesceTouchMoveEvents(*coalescedTouchMoveEvent, event))) {
+            coalescedTouchMoveEvent.emplace(event);
+            return;
+        }
+
+        Vector<NativeWebTouchEvent, 2> eventsToSend;
