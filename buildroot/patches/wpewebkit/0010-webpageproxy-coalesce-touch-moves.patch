+++ b/Source/WebKit/UIProcess/WebPageProxy.cpp
@@ -4675,6 +4675,23 @@
 }
 
 #elif ENABLE(TOUCH_EVENTS)
+static bool canCoalesceTouchMoveEvents(const WebTouchEvent& a, const WebTouchEvent& b)
+{
+    if (a.type() != WebEventType::TouchMove || b.type() != WebEventType::TouchMove || a.modifiers() != b.modifiers())
+        return false;
+
+    auto& pointsA = a.touchPoints();
+    auto& pointsB = b.touchPoints();
+    if (pointsA.size() != pointsB.size())
+        return false;
+
+    for (size_t i = 0; i < pointsA.size(); ++i) {
+        if (pointsA[i].id() != pointsB[i].id() || pointsA[i].state() != pointsB[i].state())
+            return false;
+    }
+    return true;
+}
+
 void WebPageProxy::touchEventHandlingCompleted(IPC::Connection* connection, std::optional<WebEventType> eventType, bool handled)
 {
     MESSAGE_CHECK_BASE(!internals().touchEventQueue.isEmpty(), connection);
@@ -4691,6 +4708,12 @@
         bool isEventHandled = false;
         pageClient->doneWithTouchEvent(queuedEvents.deferredTouchEvents.at(i), isEventHandled);
     }
+
