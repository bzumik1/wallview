#!/bin/sh

DATA_CONFIG=/data/wallview/wpa_supplicant.conf
BUILTIN_CONFIG=/etc/wpa_supplicant.conf
LOG=/data/wallview/network.log

log() {
	echo "network: $1"
	[ -d /data/wallview ] && echo "$(cut -d' ' -f1 /proc/uptime) $1" >> "$LOG"
}

wait_for_wlan() {
	for attempt in $(seq 1 30); do
		[ -e /sys/class/net/wlan0 ] && return 0
		sleep 0.5
	done
	return 1
}

reset_sdio() {
	echo ff380000.mmc > /sys/bus/platform/drivers/dwmmc_rockchip/unbind
	sleep 1
	echo ff380000.mmc > /sys/bus/platform/drivers/dwmmc_rockchip/bind
}

start() {
	ip link set lo up
	for round in 1 2 3; do
		wait_for_wlan && break
		reset_sdio
	done
	wait_for_wlan || { log "wlan0 missing, interfaces: $(ip -o link | cut -d: -f2 | tr -d '\n')"; return 1; }
	config=$DATA_CONFIG
	[ -f "$config" ] || config=$BUILTIN_CONFIG
	[ -f "$config" ] || { log "no Wi-Fi configured"; return 0; }
	log "starting with $config"
	mkdir -p /run/wpa_supplicant
	ip link set wlan0 up
	iw dev wlan0 set power_save off 2>/dev/null
	wpa_supplicant -B -i wlan0 -c "$config"
	udhcpc -i wlan0 -b -x hostname:wallview -s /usr/share/udhcpc/default.script -p /run/udhcpc.wlan0.pid
}

stop() {
	killall udhcpc wpa_supplicant 2>/dev/null
	ip addr flush dev wlan0 2>/dev/null
}

case "$1" in
start) start ;;
stop) stop ;;
restart) stop; sleep 1; start ;;
esac
