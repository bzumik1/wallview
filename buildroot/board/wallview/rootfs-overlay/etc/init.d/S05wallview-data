#!/bin/sh

DATA_OFFSET=$((320 * 1048576))

find_partition() {
	for uevent in /sys/class/block/*/uevent; do
		grep -qx "PARTNAME=$1" "$uevent" && sed -n 's/^DEVNAME=//p' "$uevent"
	done
}

start() {
	cache=$(find_partition cache | head -n 1)
	[ -n "$cache" ] || { echo "data: cache partition not found"; return 1; }
	loop=$(losetup -f)
	losetup -o "$DATA_OFFSET" "$loop" "/dev/$cache" || return 1
	mkdir -p /data
	if ! mount -t ext4 -o noatime "$loop" /data 2>/dev/null; then
		echo "data: creating file system"
		mke2fs -q -t ext4 -L wallview-data "$loop" && mount -t ext4 -o noatime "$loop" /data
	fi
	mkdir -p /data/wallview /data/cog
	save_pstore
}

save_pstore() {
	mountpoint -q /data || return 0
	mountpoint -q /sys/fs/pstore || mount -t pstore pstore /sys/fs/pstore 2>/dev/null || return 0
	set -- /sys/fs/pstore/dmesg-*
	crash=0
	[ -e "$1" ] && crash=1
	console=/sys/fs/pstore/console-ramoops-0
	unclean=0
	[ -e "$console" ] && ! grep -q -E "reboot: (Restarting system|Power down)|kexec_core: Starting new kernel" "$console" && unclean=1
	[ $crash = 1 ] || [ $unclean = 1 ] || return 0
	last=$(ls -1 /data/wallview/pstore 2>/dev/null | sort -n | tail -n 1)
	dir=/data/wallview/pstore/$(( ${last:-0} + 1 ))
	mkdir -p "$dir" && cp /sys/fs/pstore/* "$dir/" || return 0
	cat /proc/sys/kernel/random/boot_id > "$dir/boot_id"
	[ $crash = 1 ] && rm -f /sys/fs/pstore/dmesg-*
	ls -1 /data/wallview/pstore | sort -n | head -n -10 | sed "s#^#/data/wallview/pstore/#" | xargs -r rm -rf
	echo "data: previous boot ended without a clean reboot, kernel records saved to $dir"
}

case "$1" in
start) start ;;
stop) umount /data 2>/dev/null ;;
esac
